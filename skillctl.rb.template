class Skillctl < Formula
  desc "Agent Skills materialization CLI"
  homepage "https://github.com/azyu/skillctl"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/azyu/skillctl/releases/download/v{{VERSION}}/skillctl_{{VERSION}}_macos_arm64.tar.gz"
      sha256 "{{MACOS_ARM64_SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.intel?
      url "https://github.com/azyu/skillctl/releases/download/v{{VERSION}}/skillctl_{{VERSION}}_linux_amd64.tar.gz"
      sha256 "{{LINUX_AMD64_SHA256}}"
    end
    if Hardware::CPU.arm? && Hardware::CPU.is_64_bit?
      url "https://github.com/azyu/skillctl/releases/download/v{{VERSION}}/skillctl_{{VERSION}}_linux_arm64.tar.gz"
      sha256 "{{LINUX_ARM64_SHA256}}"
    end
  end

  def install
    bin.install "skillctl"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/skillctl version")
  end
end
